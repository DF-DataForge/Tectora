<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every morning, before the working day: the forecasts of the next 16
         days for every site with a work block in that period (Open-Meteo). -->
    <data noupdate="1">
        <record id="ir_cron_tectora_refresh_weather" model="ir.cron">
            <field name="name">Planning: weersvoorspelling ophalen (Open-Meteo)</field>
            <field name="model_id" ref="tectora_roof.model_tectora_roof_planning"/>
            <field name="state">code</field>
            <field name="code">model._cron_tectora_refresh_weather()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:13:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>

    <!-- "Weer vernieuwen" from the work blocks' list and form (the planner
         has its own button). -->
    <record id="action_tectora_refresh_weather" model="ir.actions.server">
        <field name="name">Weer vernieuwen</field>
        <field name="model_id" ref="tectora_roof.model_tectora_roof_planning"/>
        <field name="binding_model_id" ref="tectora_roof.model_tectora_roof_planning"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = model.action_tectora_refresh_weather()</field>
    </record>
</odoo>
