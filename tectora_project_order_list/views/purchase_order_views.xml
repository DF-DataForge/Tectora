<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_inherit_tectora_order_list" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.tectora.order.list</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="tectora_order_line_id" invisible="not project_id"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
