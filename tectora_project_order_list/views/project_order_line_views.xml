<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tectora_project_order_line_list" model="ir.ui.view">
        <field name="name">tectora.project.order.line.list</field>
        <field name="model">tectora.project.order.line</field>
        <field name="arch" type="xml">
            <list string="Bestellijst" editable="bottom" decoration-muted="checked" decoration-danger="is_late">
                <field name="sequence" widget="handle"/>
                <field name="checked" widget="boolean_toggle" nolabel="1"/>
                <field name="project_id" column_invisible="context.get('default_project_id')"/>
                <field name="name"/>
                <field name="order_action" widget="badge"
                       decoration-info="order_action == 'order'"
                       decoration-warning="order_action == 'stock_first'"/>
                <field name="allowed_partner_ids" column_invisible="1"/>
                <field name="partner_id" options="{'no_create': True}"/>
                <field name="order_date"/>
                <field name="expected_date"/>
                <field name="is_late" column_invisible="1"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('received', 'done', 'stock')"
                       decoration-info="status == 'ordered'"
                       decoration-warning="status == 'rfq'"/>
                <field name="note" optional="hide"/>
                <button name="action_tectora_create_purchase" type="object" icon="add_shopping_cart"
                        title="Bestelling aanmaken" invisible="checked or not partner_id"/>
                <button name="action_tectora_view_purchases" type="object" icon="shopping_cart"
                        title="Inkooporders" invisible="not purchase_count"/>
                <field name="purchase_count" column_invisible="1"/>
                <button name="action_tectora_open_form" type="object" icon="open_in_new" title="Details"/>
            </list>
        </field>
    </record>

    <record id="view_tectora_project_order_line_form" model="ir.ui.view">
        <field name="name">tectora.project.order.line.form</field>
        <field name="model">tectora.project.order.line</field>
        <field name="arch" type="xml">
            <form string="Bestellijst-onderdeel">
                <header>
                    <button name="action_tectora_create_purchase" type="object" string="Bestelling aanmaken"
                            class="btn-primary" invisible="checked"/>
                    <button name="action_tectora_toggle_checked" type="object" string="Afvinken"
                            invisible="checked"/>
                    <button name="action_tectora_toggle_checked" type="object" string="Terug openzetten"
                            invisible="not checked"/>
                    <field name="status" widget="statusbar" statusbar_visible="todo,rfq,ordered,received,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_tectora_view_purchases" type="object" class="oe_stat_button"
                                icon="shopping_cart" invisible="not purchase_count">
                            <field name="purchase_count" widget="statinfo" string="Inkooporders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="order_action" widget="radio" options="{'horizontal': true}"/>
                            <field name="allowed_partner_ids" invisible="1"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="checked"/>
                        </group>
                        <group>
                            <field name="order_date"/>
                            <field name="expected_date"/>
                            <field name="is_late" invisible="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Producten" name="products">
                            <div class="text-muted mb-2" invisible="order_action != 'stock_first'">
                                Stock eerst: bij het aanmaken van de bestelling wordt enkel het tekort besteld.
                            </div>
                            <field name="product_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="free_qty"/>
                                    <field name="shortage_qty" decoration-danger="shortage_qty &gt; 0"/>
                                </list>
                            </field>
                        </page>
                        <page string="Leveranciers volgens bestellijst" name="suppliers">
                            <field name="supplier_note" readonly="1"/>
                            <field name="allowed_partner_ids" widget="many2many_tags" readonly="1"/>
                        </page>
                        <page string="Inkooporders" name="purchases">
                            <field name="purchase_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_planned"/>
                                    <field name="amount_untaxed" sum="Totaal"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                    <field name="receipt_status" widget="badge" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tectora_project_order_line_search" model="ir.ui.view">
        <field name="name">tectora.project.order.line.search</field>
        <field name="model">tectora.project.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter name="open" string="Nog af te vinken" domain="[('checked', '=', False)]"/>
                <filter name="checked" string="Afgevinkt" domain="[('checked', '=', True)]"/>
                <separator/>
                <filter name="stock_first" string="Stock eerst" domain="[('order_action', '=', 'stock_first')]"/>
                <filter name="order" string="Bestellen" domain="[('order_action', '=', 'order')]"/>
                <separator/>
                <filter name="expected_date" string="Verwachte leverdatum" date="expected_date"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_partner" string="Leverancier" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_name" string="Onderdeel" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tectora_project_order_line" model="ir.actions.act_window">
        <field name="name">Bestellijst per project</field>
        <field name="res_model">tectora.project.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen bestellijsten</p>
            <p>Elk nieuw project krijgt een bestellijst met de onderdelen uit
               Projectopvolging › Bestellijst-onderdelen.</p>
        </field>
    </record>

    <record id="action_tectora_project_order_line_supplier" model="ir.actions.act_window">
        <field name="name">Bestellen per leverancier</field>
        <field name="res_model">tectora.project.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_group_partner': 1}</field>
    </record>

</odoo>
