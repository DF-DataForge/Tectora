<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The dashboard's material list gets the same button as the roof project. -->
    <record id="view_project_project_tectora_dashboard_stock" model="ir.ui.view">
        <field name="name">project.project.tectora.dashboard.stock</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="tectora_roof.view_project_project_tectora_dashboard"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='materials']/field[@name='roof_material_line_ids']"
                   position="after">
                <div class="mt-2" invisible="not roof_project_id">
                    <button name="action_create_material_picking" type="object"
                            class="btn btn-secondary" icon="fa-truck">
                        Levering klaarzetten
                    </button>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
