<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Runs the quotation imports in the background. Starting an import
             triggers it at once; the hourly run picks up an import that was
             interrupted (server restart, ...). -->
        <record id="ir_cron_quotation_import" model="ir.cron">
            <field name="name">Offerte-import oud systeem: offertes verwerken</field>
            <field name="model_id" ref="model_tectora_quotation_import_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
