<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_tectora_imported_orders" model="ir.actions.act_window">
        <field name="name">Orders uit oud systeem</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('tectora_legacy_number', '!=', False)]</field>
        <field name="context">{'search_default_tectora_legacy': 1}</field>
    </record>

    <record id="view_tectora_quotation_import_form" model="ir.ui.view">
        <field name="name">tectora.quotation.import.form</field>
        <field name="model">tectora.quotation.import</field>
        <field name="arch" type="xml">
            <form string="Offertes importeren">
                <div invisible="state == 'done'">
                    <div class="alert alert-info" role="alert">
                        Laad de offerte-export van het oude systeem (.xlsx) op: één rij
                        per offertelijn, met <b>offertenummer</b>, offertedatum,
                        geldigheidstermijn, verkoop (omschrijving), aantal, eenheid,
                        korting, btw-percentage, eenheidsprijs, opmerkingen, klant
                        (naam, adres, btw-nummer), totaal ex btw en <b>status</b>.
                        Elke offerte wordt een verkooporder met een verkoopkans, in de
                        staat en fase die bij haar status horen
                        (<i>Statussen oud systeem</i>). Een offerte die al in Odoo
                        staat, wordt nooit een tweede keer aangemaakt.
                    </div>
                    <group>
                        <group string="Bestand">
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="sheet_name" placeholder="bv. Export Simpla"/>
                            <field name="dry_run"/>
                        </group>
                        <group string="Offertes">
                            <field name="existing_mode"/>
                            <field name="use_legacy_name"/>
                            <field name="text_lines"/>
                            <field name="limit"/>
                        </group>
                        <group string="Verkoop">
                            <field name="user_id"/>
                            <field name="team_id"/>
                        </group>
                        <group string="Btw">
                            <field name="tax_0_id" options="{'no_create': True}"/>
                            <field name="tax_6_id" options="{'no_create': True}"/>
                            <field name="tax_21_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="state" invisible="1"/>
                </div>
                <div invisible="state != 'done'">
                    <div class="alert alert-success" role="alert">
                        <b>De offertes zijn verwerkt.</b>
                    </div>
                    <field name="summary" nolabel="1" readonly="1"
                           widget="text" class="o_field_text"/>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Importeren"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Sluiten" special="cancel"
                            class="btn-secondary" invisible="state == 'done'"/>
                    <button name="%(action_tectora_imported_orders)d" type="action"
                            string="Geïmporteerde orders" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Sluiten" special="cancel"
                            class="btn-secondary" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tectora_quotation_import" model="ir.actions.act_window">
        <field name="name">Offertes importeren</field>
        <field name="res_model">tectora.quotation.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_tectora_quotation_import_form"/>
    </record>

    <menuitem id="menu_tectora_quotation_import"
              name="Offertes importeren (oud systeem)"
              parent="sale.menu_sale_config"
              action="action_tectora_quotation_import"
              groups="sales_team.group_sale_manager"
              sequence="96"/>

    <menuitem id="menu_tectora_quotation_import_status"
              name="Statussen oud systeem"
              parent="sale.menu_sale_config"
              action="action_tectora_quotation_import_status"
              groups="sales_team.group_sale_manager"
              sequence="97"/>

</odoo>
