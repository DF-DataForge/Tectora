<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_legacy" model="ir.ui.view">
        <field name="name">sale.order.form.tectora.legacy</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="tectora_legacy_number" invisible="not tectora_legacy_number"/>
                <field name="tectora_legacy_status" invisible="not tectora_legacy_number"/>
                <field name="tectora_legacy_invoiced" invisible="not tectora_legacy_number"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_legacy" model="ir.ui.view">
        <field name="name">sale.order.search.tectora.legacy</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="tectora_legacy_number"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Uit oud systeem" name="tectora_legacy"
                        domain="[('tectora_legacy_number', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_tectora_imported_orders" model="ir.actions.act_window">
        <field name="name">Orders uit oud systeem</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('tectora_legacy_number', '!=', False)]</field>
        <field name="context">{'search_default_tectora_legacy': 1}</field>
    </record>

</odoo>
