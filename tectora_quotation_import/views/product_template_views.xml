<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_description_label" model="ir.ui.view">
        <field name="name">product.template.form.tectora.description.label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description_sale']" position="after">
                <field name="tectora_description_label"/>
            </xpath>
        </field>
    </record>

</odoo>
