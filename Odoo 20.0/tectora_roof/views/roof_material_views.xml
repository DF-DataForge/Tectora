<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tectora_roof_material_list" model="ir.ui.view">
        <field name="name">tectora.roof.material.list</field>
        <field name="model">tectora.roof.material</field>
        <field name="arch" type="xml">
            <list string="Materiaalbehoefte">
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
                <field name="unit_cost" optional="hide"/>
                <field name="cost_subtotal" sum="Totaal"/>
                <field name="source_product_id" optional="hide"/>
                <field name="bom_name" optional="hide"/>
                <field name="sale_order_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_tectora_roof_material_form" model="ir.ui.view">
        <field name="name">tectora.roof.material.form</field>
        <field name="model">tectora.roof.material</field>
        <field name="arch" type="xml">
            <form string="Materiaalbehoefte">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                        </group>
                        <group>
                            <field name="unit_cost"/>
                            <field name="cost_subtotal"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="source_product_id"/>
                            <field name="bom_name"/>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notities…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tectora_roof_material_search" model="ir.ui.view">
        <field name="name">tectora.roof.material.search</field>
        <field name="model">tectora.roof.material</field>
        <field name="arch" type="xml">
            <search string="Materiaalbehoefte">
                <field name="product_id"/>
                <field name="project_id"/>
                <field name="sale_order_id"/>
                <group>
                    <filter string="Dakproject" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Materiaal" name="group_product"
                            context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tectora_roof_material" model="ir.actions.act_window">
        <field name="name">Materiaalbehoefte</field>
        <field name="res_model">tectora.roof.material</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen materiaalbehoefte</p>
            <p>De lijst wordt automatisch aangevuld uit de stuklijsten van de
               verkochte producten wanneer een verkooporder bevestigd wordt.</p>
        </field>
    </record>

</odoo>
