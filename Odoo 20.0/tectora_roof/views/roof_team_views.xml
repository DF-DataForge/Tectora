<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tectora_roof_team_list" model="ir.ui.view">
        <field name="name">tectora.roof.team.list</field>
        <field name="model">tectora.roof.team</field>
        <field name="arch" type="xml">
            <list string="Ploegen">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="leader_id"/>
                <field name="department_id" optional="show"/>
                <field name="member_count" string="Leden"/>
                <field name="member_ids" widget="many2many_avatar_employee"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tectora_roof_team_form" model="ir.ui.view">
        <field name="name">tectora.roof.team.form</field>
        <field name="model">tectora.roof.team</field>
        <field name="arch" type="xml">
            <form string="Ploeg">
                <sheet>
                    <widget name="web_ribbon" title="Gearchiveerd" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="bv. Ploeg Noord"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="leader_id"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="member_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ploegleden" name="members">
                            <field name="employee_ids" widget="many2many_tags_avatar"
                                   options="{'no_create': True}"
                                   context="{'default_roof_team_id': id}"
                                   domain="['|', ('roof_team_id', '=', False), ('roof_team_id', '=', id)]"/>
                            <div class="text-muted small mt-2">
                                Een medewerker hoort bij één ploeg: de ploeg staat op de
                                werknemersfiche (tab Werk) en in de Werknemers-app, die per
                                ploeg georganiseerd is. Laat leeg om automatisch de medewerkers
                                van de gekozen afdeling te gebruiken.
                            </div>
                            <separator string="Effectieve ploeg"/>
                            <field name="member_ids" widget="many2many_avatar_employee"
                                   readonly="1"/>
                        </page>
                        <page string="Notities" name="notes">
                            <field name="note" placeholder="Materieel, aandachtspunten…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tectora_roof_team" model="ir.actions.act_window">
        <field name="name">Ploegen</field>
        <field name="res_model">tectora.roof.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Maak je eerste ploeg</p>
            <p>Een ploeg is een vaste groep medewerkers. Wijs een ploeg toe aan een
               dakproject en de planning-items van de individuele medewerkers worden
               automatisch aangemaakt.</p>
        </field>
    </record>

</odoo>
