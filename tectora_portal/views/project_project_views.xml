<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The project dashboard gets an Uitvoering tab: the crew's execution
         reports and the hours registered on the portal. -->
    <record id="view_project_project_tectora_dashboard_portal" model="ir.ui.view">
        <field name="name">project.project.form.tectora.dashboard.portal</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="tectora_roof.view_project_project_tectora_dashboard"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='planning']" position="after">
                <page string="Uitvoering" name="tectora_execution">
                    <group>
                        <group>
                            <field name="roof_running_timer_id" readonly="1"
                                   invisible="not roof_running_timer_id"/>
                            <field name="roof_portal_hours" readonly="1" widget="float_time"/>
                        </group>
                        <group>
                            <field name="roof_execution_report_count" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Uitvoeringsverslagen"/>
                    <field name="roof_execution_report_ids" readonly="1" nolabel="1">
                        <list string="Uitvoeringsverslagen">
                            <field name="date"/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="progress" widget="badge"
                                   decoration-success="progress == 'finished'"
                                   decoration-danger="progress == 'blocked'"
                                   decoration-info="progress == 'in_progress'"/>
                            <field name="work_done"/>
                            <field name="remarks" optional="show"/>
                            <field name="image_count" string="Foto's"/>
                        </list>
                    </field>
                    <div class="mt-2 mb-3">
                        <button name="action_view_roof_execution_reports" type="object"
                                class="btn btn-link p-0" icon="fa-external-link">
                            Alle verslagen openen
                        </button>
                    </div>
                    <separator string="Urenregistraties (portaal)"/>
                    <field name="roof_timer_ids" readonly="1" nolabel="1">
                        <list string="Urenregistraties" decoration-success="state == 'running'"
                              decoration-muted="state == 'cancelled'">
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_hours" widget="float_time" sum="Totaal"/>
                            <field name="employee_ids" widget="many2many_avatar_employee"/>
                            <field name="timesheet_hours" widget="float_time" sum="Geboekt"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'running'"
                                   decoration-info="state == 'done'"/>
                        </list>
                    </field>
                    <div class="mt-2">
                        <button name="action_view_roof_timers" type="object"
                                class="btn btn-link p-0" icon="fa-external-link">
                            Alle urenregistraties openen
                        </button>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
