<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tectora_roof_execution_report_list" model="ir.ui.view">
        <field name="name">tectora.roof.execution.report.list</field>
        <field name="model">tectora.roof.execution.report</field>
        <field name="arch" type="xml">
            <list string="Uitvoeringsverslagen">
                <field name="date"/>
                <field name="project_id"/>
                <field name="partner_id" optional="show"/>
                <field name="address" optional="hide"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="progress" widget="badge"
                       decoration-success="progress == 'finished'"
                       decoration-danger="progress == 'blocked'"
                       decoration-info="progress == 'in_progress'"/>
                <field name="work_done"/>
                <field name="image_count" string="Foto's"/>
            </list>
        </field>
    </record>

    <record id="view_tectora_roof_execution_report_form" model="ir.ui.view">
        <field name="name">tectora.roof.execution.report.form</field>
        <field name="model">tectora.roof.execution.report</field>
        <field name="arch" type="xml">
            <form string="Uitvoeringsverslag">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_roof_project" type="object" class="oe_stat_button"
                                icon="fa-home" string="Dakproject"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Werf">
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="address"/>
                            <field name="planning_id"/>
                        </group>
                        <group string="Verslag">
                            <field name="date"/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="progress"/>
                        </group>
                    </group>
                    <group string="Uitgevoerde werken">
                        <field name="work_done" nolabel="1"/>
                    </group>
                    <group>
                        <group string="Gebruikte materialen">
                            <field name="materials_used" nolabel="1"/>
                        </group>
                        <group string="Opmerkingen / problemen">
                            <field name="remarks" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Foto's">
                        <field name="image_ids" nolabel="1" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tectora_roof_execution_report_kanban" model="ir.ui.view">
        <field name="name">tectora.roof.execution.report.kanban</field>
        <field name="model">tectora.roof.execution.report</field>
        <field name="arch" type="xml">
            <kanban default_group_by="project_id">
                <field name="progress"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="date"/></strong>
                            <field name="progress" widget="badge"/>
                        </div>
                        <div class="text-muted"><field name="project_id"/></div>
                        <div class="text-truncate"><field name="work_done"/></div>
                        <div class="d-flex justify-content-between mt-1">
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <span t-if="record.image_count.raw_value">
                                <i class="fa fa-camera me-1"/><field name="image_count"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_tectora_roof_execution_report_search" model="ir.ui.view">
        <field name="name">tectora.roof.execution.report.search</field>
        <field name="model">tectora.roof.execution.report</field>
        <field name="arch" type="xml">
            <search string="Uitvoeringsverslagen">
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="work_done"/>
                <filter name="blocked" string="Geblokkeerd" domain="[('progress', '=', 'blocked')]"/>
                <filter name="finished" string="Afgewerkt" domain="[('progress', '=', 'finished')]"/>
                <separator/>
                <filter name="date" string="Datum" date="date"/>
                <group>
                    <filter name="group_project" string="Dakproject" context="{'group_by': 'project_id'}"/>
                    <filter name="group_employee" string="Opgesteld door" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_date" string="Datum" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tectora_roof_execution_report" model="ir.actions.act_window">
        <field name="name">Uitvoeringsverslagen</field>
        <field name="res_model">tectora.roof.execution.report</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen uitvoeringsverslagen</p>
            <p>
                De ploeg schrijft per werfdag een verslag op het medewerkersportaal:
                uitgevoerde werken, gebruikte materialen, opmerkingen en foto's.
            </p>
        </field>
    </record>

</odoo>
