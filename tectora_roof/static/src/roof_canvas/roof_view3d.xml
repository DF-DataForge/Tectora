<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tectora_roof.RoofView3DDialog">
        <Dialog title="this.props.title" size="'xl'">
            <div class="o_roof_view3d">
                <div class="d-flex flex-wrap align-items-center gap-3 mb-2 small">
                    <label class="d-flex align-items-center gap-1 mb-0">
                        Hoogte ×
                        <input type="range" min="1" max="20" step="1" class="form-range" style="width: 8rem;"
                               t-att-value="this.state.exaggeration"
                               t-on-input="(ev) => this.setValue('exaggeration', ev)"/>
                        <span t-out="this.state.exaggeration"/>
                    </label>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            title="Alles op ware hoogte, ook de lagen en de dakranden"
                            t-on-click="() => this.trueScale()">Ware verhoudingen</button>
                    <label class="d-flex align-items-center gap-1 mb-0">
                        Lagen uit elkaar
                        <input type="range" min="0" max="1" step="0.05" class="form-range" style="width: 8rem;"
                               t-att-value="this.state.explode"
                               t-on-input="(ev) => this.setValue('explode', ev)"/>
                    </label>
                    <label class="form-check mb-0">
                        <input type="checkbox" class="form-check-input" t-att-checked="this.state.sheets"
                               t-on-change="(ev) => this.toggleSheets(ev)"/>
                        EPDM-doeken
                    </label>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary" title="Draaien"
                                t-on-click="() => this.turn(-Math.PI / 8)">
                            <i class="oi" data-icon="rotate_left"/>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" title="Draaien"
                                t-on-click="() => this.turn(Math.PI / 8)">
                            <i class="oi" data-icon="rotate_right"/>
                        </button>
                    </div>
                    <span class="text-muted">Sleep om te draaien, scroll om te zoomen. De lagen en
                        dakranden zijn uitvergroot zodat ze zichtbaar zijn; de dakobjecten staan op
                        hun ware hoogte.</span>
                </div>
                <canvas t-ref="this.canvasRef" class="o_roof_view3d_canvas w-100 border rounded"
                        style="height: 560px; cursor: grab;"
                        t-on-pointerdown="(ev) => this.startDrag(ev)"
                        t-on-wheel="(ev) => this.onWheel(ev)"/>
                <!-- The layers: a click shows or hides one, "enkel" (or Shift-
                     click) shows it alone. -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 small">
                    <span class="text-muted">Lagen:</span>
                    <div t-foreach="this.legend" t-as="item" t-key="item.key" class="btn-group btn-group-sm">
                        <button type="button" class="btn d-flex align-items-center gap-1"
                                t-att-class="this.state.layers[item.key] ? 'btn-light border' : 'btn-outline-secondary text-muted'"
                                t-att-title="'Tonen of verbergen (Shift-klik: enkel ' + item.label + ')'"
                                t-on-click="(ev) => this.toggleLayer(item.key, ev)">
                            <span class="d-inline-block border rounded"
                                  t-att-style="'width: 1rem; height: 0.8rem; background:' + item.color + (this.state.layers[item.key] ? '' : '; opacity: 0.3')"/>
                            <t t-out="item.label"/>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" title="Enkel deze laag tonen"
                                t-on-click="() => this.showOnly(item.key)">enkel</button>
                    </div>
                    <button type="button" class="btn btn-sm btn-link" t-on-click="() => this.showAll()">Alles tonen</button>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="this.props.close">Sluiten</button>
            </t>
        </Dialog>
    </t>

</templates>
