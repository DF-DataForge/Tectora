<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The execution time norm sits next to the prices: it is, like them,
         a figure per unit of the product. -->
    <record id="product_template_form_view_inherit_tectora" model="ir.ui.view">
        <field name="name">product.template.form.inherit.tectora.roof</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <label for="tectora_minutes_per_uom" invisible="type == 'combo'"/>
                <div name="tectora_minutes_per_uom" invisible="type == 'combo'">
                    <field name="tectora_minutes_per_uom" class="oe_inline"
                           style="max-width:80px"/>
                    <span> min per </span>
                    <field name="uom_id" class="oe_inline" readonly="1"
                           nolabel="1" options="{'no_open': True}"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
