<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The two time norms sit next to the prices: like them, a figure per
         unit of the product. Hours, so 0,25 is a quarter of an hour.
         Hercalculatie follows: the size of one piece, used to turn the m² or
         m³ of a bill of materials into pieces. -->
    <record id="product_template_form_view_inherit_tectora" model="ir.ui.view">
        <field name="name">product.template.form.inherit.tectora.roof</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <label for="tectora_hours_execution_per_uom" invisible="type == 'combo'"/>
                <div name="tectora_hours_execution_per_uom" invisible="type == 'combo'">
                    <field name="tectora_hours_execution_per_uom" class="oe_inline"
                           style="max-width:80px"/>
                    <span> u per </span>
                    <field name="uom_id" class="oe_inline" readonly="1"
                           nolabel="1" options="{'no_open': True}"/>
                </div>
                <label for="tectora_hours_demolition_per_uom" invisible="type == 'combo'"/>
                <div name="tectora_hours_demolition_per_uom" invisible="type == 'combo'">
                    <field name="tectora_hours_demolition_per_uom" class="oe_inline"
                           style="max-width:80px"/>
                    <span> u per </span>
                    <field name="uom_id" class="oe_inline" readonly="1"
                           nolabel="1" options="{'no_open': True}"/>
                </div>
                <field name="tectora_recalc" invisible="type == 'combo'"/>
                <field name="tectora_recalc_uom" invisible="not tectora_recalc"
                       required="tectora_recalc" widget="radio"
                       options="{'horizontal': true}"/>
                <label for="tectora_length" string="Afmetingen (L × B × H)"
                       invisible="not tectora_recalc"/>
                <div name="tectora_recalc_dimensions" invisible="not tectora_recalc">
                    <field name="tectora_length" class="oe_inline" style="max-width:70px"
                           required="tectora_recalc"/>
                    <span invisible="tectora_recalc_uom == 'm'"> × </span>
                    <field name="tectora_width" class="oe_inline" style="max-width:70px"
                           invisible="tectora_recalc_uom == 'm'"
                           required="tectora_recalc and tectora_recalc_uom in ('m2', 'm3')"/>
                    <span invisible="tectora_recalc_uom == 'm'"> × </span>
                    <field name="tectora_height" class="oe_inline" style="max-width:70px"
                           invisible="tectora_recalc_uom == 'm'"
                           required="tectora_recalc and tectora_recalc_uom == 'm3'"/>
                    <span> m = </span>
                    <field name="tectora_recalc_size" class="oe_inline"/>
                    <span invisible="tectora_recalc_uom != 'm'"> m per stuk</span>
                    <span invisible="tectora_recalc_uom != 'm2'"> m² per stuk</span>
                    <span invisible="tectora_recalc_uom != 'm3'"> m³ per stuk</span>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
