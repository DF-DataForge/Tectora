<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- On the customer portal, show the quotation PDF (which includes the
         meetblad page) directly instead of the HTML order rendering. Only for
         orders that come from a roof project and use the Tectora quotation;
         other orders, and orders marked "Standaard offerte", keep the
         standard portal view. -->
    <template id="sale_order_portal_template_pdf"
              inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='portal_sale_content']" position="replace">
            <div t-attf-class="#{'pb-5' if report_type == 'html' else ''}" id="portal_sale_content">
                <t t-if="sale_order.roof_project_id and not sale_order.tectora_standard_quotation">
                    <!-- Invisible stub: sale_management's SaleUpdateLineButton
                         interaction reads this table's dataset unconditionally
                         and crashes when the HTML order table is absent. -->
                    <table id="sales_order_table" class="d-none"
                           t-att-data-order-id="sale_order.id"
                           t-att-data-token="sale_order.access_token"/>
                    <iframe class="w-100 d-block border-0"
                            style="min-height: 85vh;"
                            t-attf-src="/my/orders/#{sale_order.id}?report_type=pdf&amp;download=false"/>
                </t>
                <div t-else="">
                    <t t-call="#{sale_order._get_name_portal_content_view()}"/>
                </div>
            </div>
        </xpath>
    </template>

    <!-- The roof plan next to the order on the customer portal: in the
         sidebar on large screens (Odoo hides the sidebar on phones) and
         above the order content on small screens. -->
    <template id="sale_order_portal_roof_plan">
        <div class="o_tectora_portal_roof_plan">
            <strong class="smaller text-uppercase text-muted">Dakplan</strong>
            <img t-att-src="roof_plan_src" class="img-fluid d-block mt-2 border rounded" alt="Dakplan"/>
            <div class="d-flex flex-wrap column-gap-3 small text-muted mt-2">
                <span><t t-out="'%.1f m²' % roof_plan_roof.total_area"/> dakoppervlakte</span>
                <span><t t-out="'%.1f m' % roof_plan_roof.total_perimeter"/> omtrek</span>
            </div>
        </div>
    </template>

    <template id="sale_order_portal_template_roof_plan"
              inherit_id="sale.sale_order_portal_template">
        <xpath expr="//t[@t-set='entries']" position="before">
            <t t-set="roof_plan_roof" t-value="sale_order.roof_project_id"/>
            <t t-set="roof_plan_src"
               t-value="roof_plan_roof and (roof_plan_roof.canvas_snapshot or roof_plan_roof.section_count) and roof_plan_roof._get_drawing_data_uri()"/>
        </xpath>
        <xpath expr="//div[@id='sidebar_loyalty_anchor']" position="before">
            <div t-if="roof_plan_src">
                <hr/>
                <t t-call="tectora_roof.sale_order_portal_roof_plan"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='portal_sale_content']" position="before">
            <div t-if="roof_plan_src" class="d-lg-none mb-4">
                <t t-call="tectora_roof.sale_order_portal_roof_plan"/>
            </div>
        </xpath>
    </template>

</odoo>
