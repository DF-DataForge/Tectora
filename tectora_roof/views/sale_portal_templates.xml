<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- On the customer portal, show the quotation PDF (which includes the
         meetblad page) directly instead of the HTML order rendering. Only for
         orders that come from a roof project; other orders keep the standard
         portal view. -->
    <template id="sale_order_portal_template_pdf"
              inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='portal_sale_content']" position="replace">
            <div t-attf-class="#{'pb-5' if report_type == 'html' else ''}" id="portal_sale_content">
                <t t-if="sale_order.roof_project_id">
                    <iframe class="w-100 d-block border-0"
                            style="min-height: 85vh;"
                            t-attf-src="/my/orders/#{sale_order.id}?report_type=pdf&amp;download=false"/>
                </t>
                <div t-else="">
                    <t t-call="#{sale_order._get_name_portal_content_view()}"/>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
