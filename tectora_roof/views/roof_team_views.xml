<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tectora_roof_team_list" model="ir.ui.view">
        <field name="name">tectora.roof.team.list</field>
        <field name="model">tectora.roof.team</field>
        <field name="arch" type="xml">
            <list string="Ploegen">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="leader_partner_id"/>
                <field name="leader_id" optional="hide"/>
                <field name="department_id" optional="hide"/>
                <field name="partner_count" string="Leden"/>
                <field name="member_partner_ids" widget="many2many_tags_avatar"/>
                <field name="member_ids" widget="many2many_avatar_employee" optional="hide"/>
                <field name="show_in_planner" string="Op planner" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tectora_roof_team_form" model="ir.ui.view">
        <field name="name">tectora.roof.team.form</field>
        <field name="model">tectora.roof.team</field>
        <field name="arch" type="xml">
            <form string="Ploeg">
                <sheet>
                    <widget name="web_ribbon" title="Gearchiveerd" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="bv. Ploeg Noord"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="leader_partner_id" widget="many2one_avatar"
                                   options="{'no_quick_create': True}"/>
                            <field name="leader_id" invisible="leader_partner_id"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="partner_count"/>
                            <field name="member_count" string="Waarvan werknemers"/>
                            <field name="show_in_planner"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Uren loggen (portaal)" name="hours_logging">
                        <group string="Wie logt" name="hours_who">
                            <field name="hours_individual" string="Individueel (per persoon)"/>
                            <field name="hours_by_leader" string="Door ploegleider (voor de ploeg)"/>
                        </group>
                        <group string="Manier van loggen" name="hours_how">
                            <field name="hours_timer" string="Loggen via start – stop"/>
                            <field name="hours_manual" string="Uren rechtstreeks ingeven"/>
                        </group>
                        <div colspan="2" class="text-muted small">
                            De opties zijn combineerbaar: bv. de ploegleider logt via start – stop
                            voor de ploeg en wie apart werkt, geeft zijn uren individueel in.
                        </div>
                    </group>
                    <notebook>
                        <page string="Leden" name="partners">
                            <field name="partner_ids" options="{'no_quick_create': True}">
                                <list string="Ploegleden">
                                    <field name="name"/>
                                    <field name="function" optional="show"/>
                                    <field name="phone" optional="show"/>
                                    <field name="email" optional="show"/>
                                    <field name="city" optional="hide"/>
                                </list>
                            </field>
                            <div class="text-muted small mt-2">
                                De leden van de ploeg zijn contacten. Ze worden ingepland op de
                                werkblokken en registreren hun uren op het portaal (knop
                                Portaaltoegang geven op het contact); een werknemersfiche is
                                daarvoor niet nodig. Laat leeg om de werknemers van de ploeg
                                (of van de gekozen afdeling) te gebruiken.
                            </div>
                            <separator string="Effectieve ploeg"/>
                            <field name="member_partner_ids" widget="many2many_tags_avatar"
                                   readonly="1"/>
                        </page>
                        <page string="Werknemers" name="members">
                            <field name="employee_ids" widget="many2many_tags_avatar"
                                   options="{'no_create': True}"
                                   context="{'default_roof_team_id': id}"
                                   domain="['|', ('roof_team_id', '=', False), ('roof_team_id', '=', id)]"/>
                            <div class="text-muted small mt-2">
                                Werknemers met deze ploeg op hun werknemersfiche (tab Werk): hun
                                werkcontact wordt lid van de ploeg. Enkel voor werknemers worden
                                urenstaatlijnen geboekt.
                            </div>
                            <separator string="Werknemers achter de leden"/>
                            <field name="member_ids" widget="many2many_avatar_employee"
                                   readonly="1"/>
                        </page>
                        <page string="Notities" name="notes">
                            <field name="note" placeholder="Materieel, aandachtspunten…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tectora_roof_team" model="ir.actions.act_window">
        <field name="name">Ploegen</field>
        <field name="res_model">tectora.roof.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Maak je eerste ploeg</p>
            <p>Een ploeg is een vaste groep contacten met een ploegbaas. Wijs een
               ploeg toe aan een dakproject en haar leden worden mee ingepland.</p>
        </field>
    </record>

</odoo>
