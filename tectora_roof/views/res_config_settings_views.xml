<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_tectora" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tectora.roof</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Tectora Dakmeting" name="tectora_roof">
                    <block title="Kaartdiensten" help="Providers voor geocoding en satellietbeelden.">
                        <setting string="Google Maps API key"
                                 help="Geocoding API + Static Maps API. Heeft voorrang op Mapbox.">
                            <field name="tectora_google_maps_api_key"/>
                        </setting>
                        <setting string="Mapbox access token"
                                 help="Wordt gebruikt als er geen Google Maps sleutel is ingesteld.">
                            <field name="tectora_mapbox_token"/>
                        </setting>
                    </block>
                    <block title="Standaard dakopbouw"
                           help="Voorgesteld in de Dakopbouw van een dakvlak op de tekening, tot een project een eigen keuze heeft.">
                        <setting string="Dampscherm">
                            <field name="tectora_buildup_vapour_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Isolatie">
                            <field name="tectora_buildup_insulation_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Dakbedekking">
                            <field name="tectora_buildup_membrane_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Standaard algemene nota's"
                                 help="De tekst waarmee de Algemene nota's van een nieuw dakproject beginnen (laatste segment van de offerte).">
                            <field name="tectora_quote_notes" widget="text"/>
                        </setting>
                        <setting string="Marge EPDM-doek"
                                 help="Per zijde bovenop de opstand en de breedte van de dakrand (m).">
                            <field name="tectora_epdm_margin"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_tectora_roof_config" model="ir.actions.act_window">
        <field name="name">Instellingen</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'tectora_roof'}</field>
    </record>

    <!-- Terms added as a PDF: say where they end up. -->
    <record id="res_config_settings_view_form_terms_pdf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tectora.terms.pdf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_terms']" position="before">
                <div class="text-muted mt-2" invisible="terms_type != 'pdf'">
                    De voorwaarden komen op aparte pagina's achteraan de pdf van
                    offertes, orders en facturen, in kleine letters en met de
                    hoofding en voettekst van de documentlay-out.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
