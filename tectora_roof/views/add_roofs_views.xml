<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tectora_add_roofs_wizard_form" model="ir.ui.view">
        <field name="name">tectora.add.roofs.wizard.form</field>
        <field name="model">tectora.add.roofs.wizard</field>
        <field name="arch" type="xml">
            <form string="Daken toevoegen">
                <p class="text-muted">
                    Elk dak krijgt een eigen plan op het dakproject en een subsectie
                    onder de afbouw- en opbouwwerken van de offerte, met de werken
                    van het sjabloon. De hoeveelheden volgen het plan van het dak
                    zodra het getekend is.
                </p>
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="existing_count" invisible="existing_count == 0"/>
                    <field name="roof_count"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="description" placeholder="bv. garage, achterbouw, hoofddak"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Toevoegen"
                            class="btn-primary"/>
                    <button special="cancel" string="Annuleren"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sale_order_template_form_inherit_tectora" model="ir.ui.view">
        <field name="name">sale.order.template.form.inherit.tectora.roof</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field name="tectora_project_type"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
