<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_tectora" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.tectora.roof</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='category_id']" position="before">
                <field name="df_cont_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_inherit_tectora" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.tectora.roof</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="category_id" position="before">
                <field name="df_cont_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_res_partner_filter_inherit_tectora" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.tectora.roof</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="df_cont_type"/>
            </field>
            <filter name="group_country" position="after">
                <filter name="group_df_cont_type" string="Contacttype"
                        context="{'group_by': 'df_cont_type'}"/>
            </filter>
        </field>
    </record>

</odoo>
