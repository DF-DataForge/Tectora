<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The product category tree on the left of the products (kanban and
         list): a click on a category shows its products and those of its
         sub-categories; the tree unfolds per level, with the number of
         products per category. (The variants' search view is built on this
         one, so it shows the tree too.) -->
    <record id="product_template_search_view_category_panel" model="ir.ui.view">
        <field name="name">product.template.search.category.panel</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field name="categ_id" string="Productcategorieën" icon="fa-folder"
                           hierarchize="1" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

</odoo>
