<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A vehicle of the wagenpark belongs to a ploeg. -->
    <record id="fleet_vehicle_view_form_teams" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.tectora.teams</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='future_driver_id']" position="after">
                <field name="roof_team_id" options="{'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_tree_teams" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.tectora.teams</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="roof_team_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search_teams" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.tectora.teams</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="roof_team_id"/>
                <filter string="Van een ploeg" name="tectora_with_team"
                        domain="[('roof_team_id', '!=', False)]"/>
                <filter string="Ploeg" name="tectora_group_team"
                        context="{'group_by': 'roof_team_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_tectora_team_vehicles" model="ir.actions.act_window">
        <field name="name">Voertuigen per ploeg</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_tectora_group_team': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen voertuigen</p>
            <p>Voertuigen komen uit het wagenpark; wijs ze hier of op de ploeg
               aan een ploeg toe.</p>
        </field>
    </record>

</odoo>
