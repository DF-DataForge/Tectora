<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_schldr" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.schldr</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Zet offerte vast: the measurement no longer touches the
                 quotation's lines. -->
            <xpath expr="//header" position="inside">
                <button name="action_schldr_toggle_lock" type="object"
                        string="Zet offerte vast" icon="lock"
                        invisible="not schldr_project_id or schldr_locked or state not in ('draft', 'sent')"
                        help="De opmeting kan de lijnen van deze offerte niet langer overschrijven."/>
                <button name="action_schldr_toggle_lock" type="object"
                        string="Offerte vrijgeven" icon="lock_open"
                        invisible="not schldr_locked"
                        help="De opmeting mag de lijnen weer aanpassen ('Offerte bijwerken uit meting')."/>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']/.." position="after">
                <label for="schldr_tax_id"/>
                <div class="o_row">
                    <field name="schldr_tax_id" options="{'no_create': True}"/>
                    <button string="Toepassen op alle regels"
                            name="action_apply_schldr_tax" type="object"
                            class="btn-link mb-1 px-0"
                            invisible="state not in ('draft', 'sent')"
                            confirm="Het gekozen btw-tarief wordt op alle productregels gezet (zonder tarief: de btw van de producten en de fiscale positie). Doorgaan?"
                            help="Zet het gekozen btw-tarief op elke productregel van deze offerte."/>
                </div>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="schldr_project_id"
                       context="{'default_partner_id': partner_id}"/>
                <field name="schldr_project_state" invisible="1"/>
                <field name="schldr_locked" readonly="1" invisible="not schldr_locked"/>
                <field name="schldr_follow_measurement"
                       invisible="not schldr_project_id" readonly="schldr_locked"/>
                <field name="schldr_include_plan"
                       invisible="not schldr_project_id"/>
            </xpath>
            <!-- The painting project and the project are always one click away:
                 an order without a painting project gets one when the button is
                 used; the project exists once the order is confirmed. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_schldr_project" type="object"
                        class="oe_stat_button" icon="home">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="schldr_total_area" readonly="1"
                                   invisible="not schldr_project_id"/>
                            <span invisible="not schldr_project_id"> m²</span>
                            <span invisible="schldr_project_id">Nieuw</span>
                        </span>
                        <span class="o_stat_text">Schilderproject</span>
                    </div>
                </button>
                <button name="action_open_project_dashboard" type="object"
                        class="oe_stat_button" icon="speed"
                        invisible="state not in ('sale', 'done')"
                        string="Projectdashboard"/>
            </xpath>
            <!-- The estimate per line in one column: the hours of demolition
                 and of execution together (quantity x the product's hours per
                 unit, shown as hh:mm), with the column total. The split is in
                 the totals under the amounts. -->
            <xpath expr="//field[@name='order_line']/list/column[@name='price_unit']"
                   position="before">
                <field name="schldr_estimated_hours" widget="float_time"
                       string="Uren" sum="Totaal" optional="show"
                       invisible="display_type or is_downpayment" width="90px"/>
            </xpath>
            <!-- The totals of the estimate under the amounts. -->
            <xpath expr="//group[@name='sale_total']" position="inside">
                <div class="mt-2" invisible="not schldr_estimated_hours">
                    <div class="d-flex justify-content-between">
                        <span>Geschatte uren afbraak</span>
                        <span><field name="schldr_preparation_hours" widget="float_time"
                                     class="oe_inline" nolabel="1"/> u</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Geschatte uren opbouw</span>
                        <span><field name="schldr_execution_hours" widget="float_time"
                                     class="oe_inline" nolabel="1"/> u</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-1 mt-1">
                        <label for="schldr_estimated_hours" class="fw-bold"/>
                        <div class="text-end">
                            <field name="schldr_estimated_hours" widget="float_time"
                                   class="oe_inline fw-bold" nolabel="1"/>
                            <span class="fw-bold"> u</span>
                            <div class="text-muted small">
                                ± <field name="schldr_estimated_days" class="oe_inline"
                                         nolabel="1"/> werkdagen
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_schldr" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.schldr</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="schldr_project_id"/>
            </xpath>
        </field>
    </record>

</odoo>
