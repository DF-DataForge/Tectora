<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The two time norms sit next to the prices: like them, a figure per
         unit of the product. Hours, so 0,25 is a quarter of an hour.
         Hercalculatie follows: the size of one piece, used to turn the m² or
         m³ of a bill of materials into pieces; entered in mm, kept in m. -->
    <record id="product_template_form_view_inherit_schldr" model="ir.ui.view">
        <field name="name">product.template.form.inherit.schldr</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <label for="schldr_hours_execution_per_uom" invisible="type == 'combo'"/>
                <div name="schldr_hours_execution_per_uom" invisible="type == 'combo'">
                    <field name="schldr_hours_execution_per_uom" class="oe_inline"
                           style="max-width:80px"/>
                    <span> u per </span>
                    <field name="uom_id" class="oe_inline" readonly="1"
                           nolabel="1" options="{'no_open': True}"/>
                </div>
                <label for="schldr_hours_preparation_per_uom" invisible="type == 'combo'"/>
                <div name="schldr_hours_preparation_per_uom" invisible="type == 'combo'">
                    <field name="schldr_hours_preparation_per_uom" class="oe_inline"
                           style="max-width:80px"/>
                    <span> u per </span>
                    <field name="uom_id" class="oe_inline" readonly="1"
                           nolabel="1" options="{'no_open': True}"/>
                </div>
                <field name="schldr_pack_size_ids" invisible="type == 'combo'">
                    <list editable="bottom">
                        <field name="volume"/>
                        <field name="price"/>
                    </list>
                </field>
                <field name="schldr_recalc" invisible="type == 'combo'"/>
                <field name="schldr_recalc_uom" invisible="not schldr_recalc"
                       required="schldr_recalc" widget="radio"
                       options="{'horizontal': true}"/>
                <label for="schldr_length_mm" string="Afmetingen (L × B × H)"
                       invisible="not schldr_recalc"/>
                <div name="schldr_recalc_dimensions" invisible="not schldr_recalc">
                    <field name="schldr_length_mm" class="oe_inline" style="max-width:80px"
                           required="schldr_recalc"/>
                    <span> × </span>
                    <field name="schldr_width_mm" class="oe_inline" style="max-width:80px"
                           required="schldr_recalc and schldr_recalc_uom in ('m2', 'm3')"/>
                    <span> × </span>
                    <field name="schldr_height_mm" class="oe_inline" style="max-width:80px"
                           required="schldr_recalc and schldr_recalc_uom == 'm3'"/>
                    <span> mm = </span>
                    <field name="schldr_recalc_size" class="oe_inline"/>
                    <span invisible="schldr_recalc_uom != 'm'"> m per stuk</span>
                    <span invisible="schldr_recalc_uom != 'm2'"> m² per stuk</span>
                    <span invisible="schldr_recalc_uom != 'm3'"> m³ per stuk</span>
                </div>
                <label for="schldr_recalc_margin" string="Veiligheidsmarge"
                       invisible="not schldr_recalc"/>
                <div name="schldr_recalc_margin" invisible="not schldr_recalc">
                    <field name="schldr_recalc_margin" class="oe_inline" style="max-width:80px"/>
                    <span> %</span>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
