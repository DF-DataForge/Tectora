<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_schldr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.schldr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Schldr" name="schldr_paint">
                    <block title="Meten"
                           help="Hoe het plan omgerekend wordt naar de hoeveelheden op de offerte.">
                        <setting string="Openingen aftrekken vanaf"
                                 help="Een deur of raam kleiner dan dit blijft in de aangerekende muuroppervlakte. 0: elke opening gaat eraf. De verf wordt altijd zonder de openingen berekend.">
                            <field name="schldr_deduct_min_area" class="oe_inline"/> m²
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_schldr_paint_config" model="ir.actions.act_window">
        <field name="name">Instellingen</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'schldr_paint'}</field>
    </record>

    <!-- Terms added as a PDF: say where they end up. -->
    <record id="res_config_settings_view_form_terms_pdf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.schldr.terms.pdf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_terms']" position="before">
                <div class="text-muted mt-2" invisible="terms_type != 'pdf'">
                    De voorwaarden komen op aparte pagina's achteraan de pdf van
                    offertes, orders en facturen, in kleine letters en met de
                    hoofding en voettekst van de documentlay-out.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
