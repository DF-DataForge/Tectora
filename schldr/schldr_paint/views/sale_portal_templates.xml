<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The plan next to the order on the customer portal: in the sidebar,
         under the buttons, on a wide screen; above the order on a narrow one.
         Shown when the order includes the plan ("Plan toevoegen"), as in the
         PDF; with several levels, the plan of each. -->
    <template id="sale_order_portal_plan">
        <div class="o_schldr_portal_plan">
            <h6 class="small text-muted mb-1">
                <t t-if="len(schldr_plans) &gt; 1">Plannen</t><t t-else="">Plan</t>
            </h6>
            <div t-foreach="schldr_plans" t-as="plan" class="mt-2 mb-3">
                <strong t-if="plan['title']" class="d-block small" t-out="plan['title']"/>
                <img t-att-src="plan['image']" class="img-fluid border rounded"
                     t-att-alt="plan['title'] or 'Plan'"/>
                <div class="small text-muted mt-1">
                    <span><t t-out="len(plan['rooms'])"/> ruimtes</span> ·
                    <span><t t-out="'%.1f m²' % plan['wall_area']"/> muren</span>
                </div>
            </div>
        </div>
    </template>

    <template id="sale_order_portal_template_plan"
              inherit_id="sale.sale_order_portal_template">
        <xpath expr="//t[@t-set='entries']" position="before">
            <t t-set="schldr_plans"
               t-value="[plan for plan in sale_order.schldr_project_id._schldr_plans() if plan['image']] if sale_order.schldr_project_id and sale_order.schldr_include_plan else []"/>
        </xpath>
        <xpath expr="//div[@id='sidebar_loyalty_anchor']" position="before">
            <div t-if="schldr_plans">
                <hr/>
                <t t-call="schldr_paint.sale_order_portal_plan"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='portal_sale_content']" position="before">
            <div t-if="schldr_plans" class="d-lg-none mb-4">
                <t t-call="schldr_paint.sale_order_portal_plan"/>
            </div>
        </xpath>
    </template>

</odoo>
