<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_schldr_products" model="ir.actions.act_window">
        <field name="name">Producten</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('sale_ok', '=', True)]</field>
        <field name="context">{'default_sale_ok': True, 'default_type': 'consu', 'default_is_storable': True}</field>
    </record>

    <!-- The projects overview: key figures over all projects, each opening
         the projects behind it (project_overview.py, static/src/project_overview). -->
    <record id="action_schldr_project_overview" model="ir.actions.client">
        <field name="name">Projectoverzicht</field>
        <field name="tag">schldr_project_overview</field>
    </record>

    <!-- First under Project, so the app opens on it (its root menu has no
         action of its own and opens its first submenu); Projecten stays
         right after it. -->
    <menuitem id="menu_project_overview"
              name="Overzicht"
              parent="project.menu_main_pm"
              action="action_schldr_project_overview"
              sequence="0"/>

    <menuitem id="menu_schldr_root"
              name="Schldr"
              web_icon="schldr_paint,static/description/icon.png"
              sequence="45"/>

    <menuitem id="menu_schldr_projects"
              name="Schilderprojecten"
              parent="menu_schldr_root"
              action="action_schldr_paint_project"
              sequence="10"/>

    <menuitem id="menu_schldr_systems"
              name="Verfsystemen"
              parent="menu_schldr_root"
              action="action_schldr_paint_system"
              sequence="20"/>

    <menuitem id="menu_schldr_colours"
              name="Kleuren"
              parent="menu_schldr_root"
              action="action_schldr_colour"
              sequence="25"/>

    <menuitem id="menu_schldr_element_types"
              name="Deuren, ramen en radiatoren"
              parent="menu_schldr_root"
              action="action_schldr_element_type"
              sequence="70"/>

    <!-- Schilderwerk holds the data of the site (the plan, the paint
         systems, the colours). What organises the works (planning,
         materials, purchases, the order list, hours and reports) lives in
         Project -> Werf, next to the projects it belongs to. -->
    <menuitem id="menu_project_worksite"
              name="Werf"
              parent="project.menu_main_pm"
              sequence="3"/>

    <!-- The work blocks of the painting projects; the shifts themselves live in
         the standard Planning app, whose views carry the schilderproject. -->
    <menuitem id="menu_schldr_planning"
              name="Werkblokken"
              parent="menu_project_worksite"
              action="action_schldr_paint_planning"
              sequence="10"/>

    <menuitem id="menu_schldr_materials"
              name="Materiaalbehoefte"
              parent="menu_project_worksite"
              action="action_schldr_paint_material"
              sequence="20"/>

    <menuitem id="menu_schldr_products"
              name="Producten"
              parent="menu_schldr_root"
              action="action_schldr_products"
              sequence="30"/>

    <!-- noupdate: with the Planning bridge installed this menu is moved to
         Planning -> Configuratie, and an upgrade must not drag it back here. -->
    <data noupdate="1">
        <menuitem id="menu_schldr_teams"
                  name="Ploegen"
                  parent="menu_schldr_root"
                  action="action_schldr_paint_team"
                  sequence="80"/>
    </data>

    <menuitem id="menu_schldr_config"
              name="Instellingen"
              parent="menu_schldr_root"
              action="action_schldr_paint_config"
              groups="base.group_system"
              sequence="90"/>

</odoo>
