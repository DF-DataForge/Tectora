<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paint systems: what is done to a surface, sold as one works item. -->
    <record id="view_schldr_paint_system_form" model="ir.ui.view">
        <field name="name">schldr.paint.system.form</field>
        <field name="model">schldr.paint.system</field>
        <field name="arch" type="xml">
            <form string="Verfsysteem">
                <sheet>
                    <widget name="web_ribbon" title="Gearchiveerd" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="bv. Muren: primer + 2 lagen mat"/></h1>
                    </div>
                    <group>
                        <group string="Op de offerte">
                            <field name="product_id"/>
                            <field name="sale_measure"/>
                            <field name="description"
                                   placeholder="bv. Voorstrijken en twee lagen afwerken in matte muurverf."/>
                        </group>
                        <group string="Te zetten op">
                            <field name="on_walls"/>
                            <field name="on_ceilings"/>
                            <field name="on_floors"/>
                            <field name="on_woodwork"/>
                            <field name="on_objects"/>
                        </group>
                    </group>
                    <separator string="Lagen"/>
                    <field name="layer_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="role"/>
                            <field name="product_id"/>
                            <field name="coats"/>
                            <field name="spreading_rate"/>
                            <field name="uom_id" string="per" optional="show"/>
                            <field name="dilution_pct" optional="show"/>
                            <field name="waste_pct" optional="show"/>
                            <field name="hours_per_coat"/>
                            <field name="tinted"/>
                        </list>
                    </field>
                    <group>
                        <group string="Tijd per verkochte eenheid">
                            <field name="prep_hours"/>
                            <field name="paint_hours"/>
                        </group>
                        <group string="Materiaal">
                            <field name="material_cost"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_schldr_paint_system_list" model="ir.ui.view">
        <field name="name">schldr.paint.system.list</field>
        <field name="model">schldr.paint.system</field>
        <field name="arch" type="xml">
            <list string="Verfsystemen">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="sale_measure"/>
                <field name="on_walls" optional="show"/>
                <field name="on_ceilings" optional="show"/>
                <field name="on_floors" optional="hide"/>
                <field name="on_woodwork" optional="show"/>
                <field name="on_objects" optional="hide"/>
                <field name="prep_hours" optional="show"/>
                <field name="paint_hours" optional="show"/>
                <field name="material_cost" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_schldr_paint_system" model="ir.actions.act_window">
        <field name="name">Verfsystemen</field>
        <field name="res_model">schldr.paint.system</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Maak je eerste verfsysteem</p>
            <p>Een verfsysteem is wat je op een oppervlak doet en als één werkpost
               verkoopt: de voorbereiding en de lagen, elk met hun product, het
               aantal lagen en het rendement.</p>
        </field>
    </record>

    <!-- Colours -->
    <record id="view_schldr_colour_list" model="ir.ui.view">
        <field name="name">schldr.colour.list</field>
        <field name="model">schldr.colour</field>
        <field name="arch" type="xml">
            <list string="Kleuren" editable="bottom">
                <field name="collection"/>
                <field name="code"/>
                <field name="name"/>
                <field name="hex" widget="color"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_schldr_colour_search" model="ir.ui.view">
        <field name="name">schldr.colour.search</field>
        <field name="model">schldr.colour</field>
        <field name="arch" type="xml">
            <search string="Kleuren">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('collection', 'ilike', self)]"/>
                <filter string="Gearchiveerd" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Kleurwaaier" name="group_collection" context="{'group_by': 'collection'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_schldr_colour" model="ir.actions.act_window">
        <field name="name">Kleuren</field>
        <field name="res_model">schldr.colour</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Standard doors, windows and radiators -->
    <record id="view_schldr_element_type_list" model="ir.ui.view">
        <field name="name">schldr.element.type.list</field>
        <field name="model">schldr.element.type</field>
        <field name="arch" type="xml">
            <list string="Deuren, ramen en radiatoren" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="width"/>
                <field name="height"/>
                <field name="sill"/>
                <field name="reveal"/>
                <field name="has_leaf" invisible="kind != 'door'"/>
                <field name="has_frame" invisible="kind not in ('door', 'window')"/>
                <field name="frame_girth" optional="hide"/>
                <field name="factor" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_schldr_element_type" model="ir.actions.act_window">
        <field name="name">Deuren, ramen en radiatoren</field>
        <field name="res_model">schldr.element.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
