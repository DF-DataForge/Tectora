<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_schldr_project" model="ir.actions.report">
        <field name="name">Meetblad opmeting</field>
        <field name="model">schldr.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">schldr_paint.report_schldr_project</field>
        <field name="print_report_name">'Meetblad %s' % (object.code)</field>
        <field name="binding_model_id" ref="model_schldr_project"/>
        <field name="binding_type">report</field>
    </record>

    <!-- One meetblad page; expects `plan_doc` (schldr.project) to be
         set. Reused by the standalone report and inside the quotation PDF. -->
    <!-- The meetblad inside the standard document layout. -->
    <template id="report_schldr_project_page">
        <t t-call="web.external_layout">
            <t t-call="schldr_paint.report_schldr_project_content"/>
        </t>
    </template>

    <!-- The meetblad itself, without layout. Expects `plan_doc`. Every level
         (its plan and the sizes of its rooms) starts a page; the colour
         schedule closes the sheet. -->
    <template id="report_schldr_project_content">
            <div class="page">
                <h3 class="mb-1">
                    Meetblad <t t-out="plan_doc.code"/> — <t t-out="plan_doc.name"/>
                </h3>
                <div class="row small mb-2">
                    <div class="col-7">
                        <strong>Klant:</strong>
                        <t t-out="plan_doc.partner_id.display_name or '-'"/><br/>
                        <strong>Werfadres:</strong>
                        <t t-out="plan_doc.address or '-'"/>
                    </div>
                    <div class="col-5">
                        <strong>Projecttype:</strong>
                        <t t-out="plan_doc._project_type_label()"/><br/>
                        <strong>Ruimtes:</strong>
                        <t t-out="plan_doc.room_count"/>
                    </div>
                </div>
                <t t-set="plans" t-value="plan_doc._schldr_plans()"/>
                <div t-if="not plans" class="text-muted text-center mb-2">
                    (nog geen plan getekend)
                </div>
                <t t-foreach="plans" t-as="plan">
                    <div t-att-style="'page-break-before: always;' if not plan_first else None">
                        <h4 t-if="plan['title']" class="mt-2 mb-2" t-out="plan['title']"/>
                        <div t-if="plan['image']" class="text-center mb-2">
                            <img t-att-src="plan['image']"
                                 style="max-width: 100%; max-height: 115mm;"
                                 t-att-alt="plan['title'] or 'Plan'"/>
                        </div>
                        <table class="table table-sm small mb-2">
                            <thead>
                                <tr>
                                    <th>Ruimte</th>
                                    <th class="text-end">Hoogte (m)</th>
                                    <th class="text-end">Vloer (m²)</th>
                                    <th class="text-end">Muren (m²)</th>
                                    <th class="text-end">Plafond (m²)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="plan['rooms']" t-as="room">
                                    <td t-out="room.name"/>
                                    <td class="text-end" t-out="'%.2f' % room.height"/>
                                    <td class="text-end" t-out="'%.2f' % room.floor_area"/>
                                    <td class="text-end" t-out="'%.2f' % room.wall_area"/>
                                    <td class="text-end" t-out="'%.2f' % room.ceiling_area"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Totaal</th>
                                    <th/>
                                    <th class="text-end" t-out="'%.2f' % plan['floor_area']"/>
                                    <th class="text-end" t-out="'%.2f' % plan['wall_area']"/>
                                    <th class="text-end" t-out="'%.2f' % plan['ceiling_area']"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
                <t t-set="schedule" t-value="plan_doc._schldr_colour_schedule()"/>
                <t t-if="schedule">
                    <h5 class="mt-3 mb-1">Kleurenstaat</h5>
                    <t t-call="schldr_paint.report_schldr_colour_schedule"/>
                </t>
                <div t-if="len(plans) &gt; 1" class="text-end">
                    <strong>Totaal alle verdiepingen:</strong>
                    <t t-out="'%.2f m² muren' % plan_doc.total_wall_area"/> —
                    <t t-out="'%.2f m² plafonds' % plan_doc.total_ceiling_area"/>
                </div>
            </div>
    </template>

    <!-- What is painted where: per room the paint system, the colour and the
         quantity. Expects `schedule` (schldr.project._schldr_colour_schedule). -->
    <template id="report_schldr_colour_schedule">
        <table class="table table-sm small mb-2">
            <thead>
                <tr>
                    <th style="width: 22%;">Ruimte</th>
                    <th style="width: 14%;">Wat</th>
                    <th>Verfsysteem</th>
                    <th style="width: 24%;">Kleur</th>
                    <th class="text-end" style="width: 12%;">Hoeveelheid</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="schedule" t-as="entry">
                    <tr t-foreach="entry['rows']" t-as="row">
                        <td><strong t-if="row_first" t-out="entry['room']"/></td>
                        <td t-out="row['group']"/>
                        <td t-out="row['system']"/>
                        <td>
                            <span t-if="row['hex']"
                                  t-attf-style="display: inline-block; width: 10px; height: 10px; border: 1px solid #999; background-color: #{row['hex']};"/>
                            <t t-out="row['colour'] or '-'"/>
                        </td>
                        <td class="text-end">
                            <t t-out="'%.2f' % row['quantity']"/> <t t-out="row['unit']"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="report_schldr_project">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="plan_doc" t-value="doc"/>
                <t t-call="schldr_paint.report_schldr_project_page"/>
            </t>
        </t>
    </template>

    <!-- The quotation PDF: Odoo's standard document, followed by the meetblad
         when the order includes the plan ("Plan toevoegen"). Since
         Odoo 19 the per-document loop lives in sale.report_saleorder_raw. -->
    <template id="report_saleorder_inherit_schldr" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="attributes">
            <attribute name="t-call">schldr_paint.report_saleorder_document_dispatch</attribute>
        </xpath>
    </template>

    <template id="report_saleorder_document_dispatch">
        <t t-call="sale.report_saleorder_document"/>
        <t t-if="doc.schldr_project_id and doc.schldr_include_plan">
            <t t-set="plan_doc" t-value="doc.schldr_project_id"/>
            <t t-call="schldr_paint.report_schldr_project_page"/>
        </t>
    </template>

</odoo>
