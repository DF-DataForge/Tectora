<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="schldr_paint.Plan3DDialog">
        <Dialog title="'Het plan in 3D'" size="'xl'">
            <div class="o_schldr_plan_3d">
                <div class="d-flex align-items-center gap-3 mb-2 small">
                    <label t-if="this.props.document.levels.length &gt; 1" class="form-check-label">
                        <input type="checkbox" class="form-check-input me-1"
                               t-att-checked="this.state.allLevels"
                               t-on-change="() => this.toggle('allLevels')"/>
                        Alle verdiepingen
                    </label>
                    <label class="form-check-label">
                        <input type="checkbox" class="form-check-input me-1"
                               t-att-checked="this.state.showSlopes"
                               t-on-change="() => this.toggle('showSlopes')"/>
                        Schuine plafonds
                    </label>
                    <span class="text-muted ms-auto">Sleep om te draaien, scrol om te zoomen.</span>
                </div>
                <canvas t-ref="this.canvasRef"
                        t-on-pointerdown="this.onPointerDown"
                        t-on-pointermove="this.onPointerMove"
                        t-on-pointerup="this.onPointerUp"
                        t-on-wheel="this.onWheel"/>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-on-click="this.props.close">Sluiten</button>
            </t>
        </Dialog>
    </t>

</templates>
