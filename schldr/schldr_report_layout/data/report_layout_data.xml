<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- The Schldr layout as a choice in Settings -> Configure Document
             Layout; the configurator renders its own live preview. -->
        <record id="report_layout_schldr" model="report.layout">
            <field name="name">Schldr</field>
            <field name="sequence">1</field>
            <field name="view_id" ref="schldr_report_layout.external_layout_schldr"/>
        </record>

        <!-- The Schldr letterhead (briefpapier), and the letterhead with the
             accent edge as the lower side of its band. -->
        <record id="report_layout_schldr_letterhead" model="report.layout">
            <field name="name">Schldr Briefpapier</field>
            <field name="sequence">2</field>
            <field name="view_id" ref="schldr_report_layout.external_layout_schldr_letterhead"/>
        </record>
        <record id="report_layout_schldr_letterhead_light" model="report.layout">
            <field name="name">Schldr Briefpapier licht</field>
            <field name="sequence">3</field>
            <field name="view_id" ref="schldr_report_layout.external_layout_schldr_letterhead_light"/>
        </record>
        <record id="report_layout_schldr_accent_letterhead" model="report.layout">
            <field name="name">Schldr Briefpapier met accentrand</field>
            <field name="sequence">4</field>
            <field name="view_id" ref="schldr_report_layout.external_layout_schldr_accent_letterhead"/>
        </record>
    </data>
</odoo>
