<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A button per product line opens its bill of materials to adapt for
         this quotation; it shows in colour once the line has its own. One
         narrow column (static/src/sale_bom_button), so the description keeps
         its width. -->
    <record id="view_order_form_tectora_sale_bom" model="ir.ui.view">
        <field name="name">sale.order.form.tectora.sale.bom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']" position="after">
                <field name="tectora_has_sale_bom" widget="tectora_sale_bom_button"
                       nolabel="1" width="32" readonly="1"
                       invisible="display_type or is_downpayment or not product_id"/>
            </xpath>
        </field>
    </record>

</odoo>
