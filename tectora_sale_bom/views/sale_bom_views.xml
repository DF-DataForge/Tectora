<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The dialog opened from an order line. -->
    <record id="view_tectora_sale_bom_form" model="ir.ui.view">
        <field name="name">tectora.sale.bom.form</field>
        <field name="model">tectora.sale.bom</field>
        <field name="arch" type="xml">
            <form string="Stuklijst op maat">
                <field name="order_state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="price_differs" invisible="1"/>
                <sheet>
                    <group>
                        <group>
                            <field name="sale_line_id" invisible="1"/>
                            <field name="product_id" readonly="1"/>
                            <label for="product_uom_qty"/>
                            <div class="o_row">
                                <field name="product_uom_qty" readonly="1"/>
                                <field name="product_uom_id" readonly="1" groups="uom.group_uom"/>
                            </div>
                            <field name="source_bom_id" readonly="1"
                                   invisible="not source_bom_id"/>
                        </group>
                        <group>
                            <field name="cost_per_unit"/>
                            <field name="margin_percent" readonly="order_state == 'cancel'"/>
                            <field name="price_computed"
                                   decoration-warning="price_differs"/>
                            <field name="line_price_unit"/>
                            <div colspan="2" class="text-end">
                                <button name="action_update_product_price" type="object"
                                        string="Berekende prijs als verkoopprijs product"
                                        class="btn-link p-0"
                                        groups="sales_team.group_sale_manager"
                                        confirm="De berekende prijs wordt de verkoopprijs van het product, voor alle nieuwe offertes. Doorgaan?"/>
                            </div>
                        </group>
                    </group>
                    <field name="line_ids" readonly="order_state == 'cancel'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="fixed_quantity" string="Vast" width="60px"/>
                            <field name="total_quantity"/>
                            <field name="product_uom_id" groups="uom.group_uom"
                                   options="{'no_create': True, 'no_open': True}"
                                   widget="many2one_uom"/>
                            <field name="unit_cost"/>
                            <field name="cost_subtotal" sum="Totaal"/>
                        </list>
                    </field>
                    <div class="text-muted small">
                        Hoeveelheden per eenheid van het verkochte product
                        (<field name="product_unit_id" readonly="1" class="oe_inline"/>),
                        of voor de hele lijn wanneer "Vast" aangevinkt is.
                        De stuklijst op maat vervangt die van het product in de
                        materiaallijst van deze order.
                    </div>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Opslaan"
                            class="btn-primary" invisible="order_state == 'cancel'"/>
                    <button name="action_save_apply_price" type="object"
                            string="Opslaan en prijs toepassen" class="btn-secondary"
                            invisible="order_state == 'cancel' or not price_differs"
                            confirm="De verkoopprijs van de orderlijn wordt de berekende prijs. Doorgaan?"/>
                    <button name="action_save_as_default" type="object"
                            string="Opslaan als standaardstuklijst" class="btn-secondary"
                            groups="mrp.group_mrp_manager"
                            invisible="order_state == 'cancel'"
                            confirm="Deze componenten worden de standaardstuklijst van het product: elke nieuwe offerte vertrekt ervan. Doorgaan?"/>
                    <button name="action_reset" type="object"
                            string="Standaard herstellen" class="btn-secondary"
                            invisible="not id or order_state == 'cancel'"
                            confirm="De aanpassingen verdwijnen en de lijn gebruikt opnieuw de stuklijst van het product. Doorgaan?"/>
                    <button special="cancel" string="Sluiten" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
