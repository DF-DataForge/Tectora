<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tectora_project_phase_list" model="ir.ui.view">
        <field name="name">tectora.project.phase.list</field>
        <field name="model">tectora.project.phase</field>
        <field name="arch" type="xml">
            <list string="Projectfases" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="subtitle"/>
                <field name="deadline_reference"/>
                <field name="deadline_offset" invisible="not deadline_reference"/>
            </list>
        </field>
    </record>

    <record id="action_tectora_project_phase" model="ir.actions.act_window">
        <field name="name">Projectfases</field>
        <field name="res_model">tectora.project.phase</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Maak een projectfase aan</p>
            <p>Elke fase wordt een mijlpaal op elk nieuw project, met de taken
               uit de taaksjablonen van die fase.</p>
        </field>
    </record>

</odoo>
