<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_tectora" model="ir.ui.view">
        <field name="name">purchase.order.form.tectora</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="tectora_roof_project_id"
                       invisible="not tectora_roof_project_id"/>
                <field name="tectora_logistics_route_id"
                       invisible="not tectora_logistics_route_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tectora_materials" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="tectora_material_count == 0">
                    <field name="tectora_material_count" widget="statinfo" string="Materiaalbehoefte"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_tree_tectora" model="ir.ui.view">
        <field name="name">purchase.order.list.tectora</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="tectora_roof_project_id" optional="hide"/>
                <field name="tectora_logistics_route_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_tectora" model="ir.ui.view">
        <field name="name">purchase.order.rfq.list.tectora</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="tectora_roof_project_id" optional="hide"/>
                <field name="tectora_logistics_route_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_tectora" model="ir.ui.view">
        <field name="name">purchase.order.search.tectora</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="tectora_roof_project_id"/>
                <filter string="Dakproject" name="tectora_group_roof_project"
                        context="{'group_by': 'tectora_roof_project_id'}"/>
                <filter string="Logistieke route" name="tectora_group_route"
                        context="{'group_by': 'tectora_logistics_route_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
