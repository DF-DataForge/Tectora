<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tectora_logistics_route_list" model="ir.ui.view">
        <field name="name">tectora.logistics.route.list</field>
        <field name="model">tectora.logistics.route</field>
        <field name="arch" type="xml">
            <list string="Logistieke routes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="delivery_type"/>
                <field name="warehouse_id"/>
                <field name="picking_type_id" optional="show"/>
                <field name="stock_route_id" optional="hide"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tectora_logistics_route_form" model="ir.ui.view">
        <field name="name">tectora.logistics.route.form</field>
        <field name="model">tectora.logistics.route</field>
        <field name="arch" type="xml">
            <form string="Logistieke route">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_materials" type="object"
                                class="oe_stat_button" icon="fa-cubes"
                                invisible="material_count == 0">
                            <field name="material_count" widget="statinfo" string="Materiaallijnen"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Gearchiveerd" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="bv. Dropship — levering op de werf"/></h1>
                    </div>
                    <group>
                        <group string="Levering">
                            <field name="active" invisible="1"/>
                            <field name="delivery_type" widget="radio"/>
                            <field name="warehouse_id" invisible="delivery_type != 'warehouse'"
                                   required="delivery_type == 'warehouse'"
                                   domain="company_id and [('company_id', '=', company_id)] or []"/>
                            <field name="is_default"/>
                        </group>
                        <group string="Odoo">
                            <field name="picking_type_id"
                                   domain="[('code', 'in', ('incoming', 'dropship'))] + (company_id and [('company_id', '=', company_id)] or [])"/>
                            <field name="stock_route_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Wanneer gebruikt de dienst deze route?"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tectora_logistics_route_search" model="ir.ui.view">
        <field name="name">tectora.logistics.route.search</field>
        <field name="model">tectora.logistics.route</field>
        <field name="arch" type="xml">
            <search string="Logistieke routes">
                <field name="name"/>
                <field name="warehouse_id"/>
                <filter string="Dropship" name="dropship" domain="[('delivery_type', '=', 'dropship')]"/>
                <filter string="Magazijn" name="warehouse" domain="[('delivery_type', '=', 'warehouse')]"/>
                <separator/>
                <filter string="Gearchiveerd" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_tectora_logistics_route" model="ir.actions.act_window">
        <field name="name">Logistieke routes</field>
        <field name="res_model">tectora.logistics.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen logistieke route</p>
            <p>Een logistieke route zegt waar besteld materiaal naartoe gaat:
               rechtstreeks naar de werf (dropship) of naar het magazijn.
               Elke materiaallijn krijgt een route, en de inkooporders die
               eruit gemaakt worden krijgen de bijhorende operatie.</p>
        </field>
    </record>

    <menuitem id="menu_tectora_logistics_routes"
              name="Logistieke routes"
              parent="tectora_roof.menu_tectora_root"
              action="action_tectora_logistics_route"
              groups="purchase.group_purchase_manager,base.group_system"
              sequence="85"/>

    <!-- Purchase people configure them where they configure the rest. -->
    <menuitem id="menu_tectora_logistics_routes_purchase"
              name="Logistieke routes (Dakmeting)"
              parent="purchase.menu_purchase_config"
              action="action_tectora_logistics_route"
              sequence="60"/>

</odoo>
