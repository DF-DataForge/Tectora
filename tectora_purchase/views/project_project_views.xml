<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The project dashboard's material tab shows how far the ordering is. -->
    <record id="view_project_project_tectora_dashboard_purchase" model="ir.ui.view">
        <field name="name">project.project.tectora.dashboard.purchase</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="tectora_roof.view_project_project_tectora_dashboard"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='roof_material_line_ids']/list/field[@name='product_uom_id']" position="after">
                <field name="vendor_id" optional="show"/>
                <field name="logistics_route_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='roof_material_line_ids']/list/field[@name='sale_order_id']" position="after">
                <field name="purchase_order_id" optional="show"/>
                <field name="purchase_state" optional="show" widget="badge"
                       decoration-muted="purchase_state == 'to_order'"
                       decoration-info="purchase_state == 'rfq'"
                       decoration-warning="purchase_state == 'ordered'"
                       decoration-success="purchase_state == 'received'"/>
            </xpath>
        </field>
    </record>

</odoo>
