<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_tectora_purchase" model="ir.ui.view">
        <field name="name">product.template.form.tectora.logistics.route</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <group string="Dakmeting" name="tectora_logistics">
                    <field name="tectora_logistics_route_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
