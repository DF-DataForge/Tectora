<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The roof-edge header as a vector: sky tint above, the teal ridge line
         of a flat roof running to its peak at three quarters of the width, the
         roof edge as two light bands beneath it. Drawn in the company's primary
         colour so the configurator's colours apply to it. -->
    <template id="tectora_header_shape">
        <svg t-att-class="shape_class" preserveAspectRatio="none" t-att-height="header_shape_height"
             viewBox="0 0 1000 350" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient t-attf-id="tectora_sky_#{company.id}" x1="1" y1="0" x2="0" y2="1">
                    <stop offset="0" t-att-stop-color="tectora_color" stop-opacity=".16"/>
                    <stop offset="1" t-att-stop-color="tectora_color" stop-opacity=".03"/>
                </linearGradient>
            </defs>
            <!-- sky -->
            <path d="M0 0H1000V118L777 24L0 192Z" t-attf-fill="url(#tectora_sky_#{company.id})"/>
            <!-- roof edge: fascia -->
            <path d="M0 192L777 24L1000 118V142L777 48L0 216Z" fill="#ffffff" fill-opacity=".85"/>
            <path d="M0 216L777 48L1000 142V168L777 74L0 242Z" t-att-fill="tectora_color" fill-opacity=".12"/>
            <!-- ridge line -->
            <path d="M0 192L777 24L1000 118" t-att-stroke="tectora_color" stroke-width="3"
                  stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
        </svg>
    </template>

    <!-- Odoo 20 builds every layout from shared parts: the company address
         list, the body (address block, title, and the table design picked in
         the configurator) and the footer content. Only the header shape and
         the footer line are Tectora's own. -->
    <template id="external_layout_tectora">
        <t t-set="tectora_color" t-value="company.primary_color or '#008B93'"/>
        <!-- the shape is 200px high; the header content sits under the roof
             edge (lower on the left, where the edge is low, higher on the
             right, under the peak), so the whole header is about 240px -->
        <t t-set="header_shape_height" t-value="'200'"/>

        <!-- HEADER -->
        <div t-attf-class="header o_company_#{company.id}_layout o_tectora_header {{report_type != 'pdf' and 'h-0'}}">
            <t t-call="tectora_report_layout.tectora_header_shape"
               shape_class="'o_tectora_header_shape start-0 top-0 w-100 z-n1 ' + (report_type == 'pdf' and 'position-fixed' or 'position-absolute')"/>
            <div class="d-flex justify-content-between o_tectora_header_content" style="padding-top: 100px;">
                <div class="w-50 o_tectora_header_brand" style="margin-top: 42px;">
                    <img t-if="company.logo" class="o_company_logo mb-1" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    <div t-if="company.report_header" t-field="company.report_header" class="o_company_tagline fw-bold">Company tagline</div>
                </div>
                <div name="company_address" class="w-50 text-end small">
                    <t t-call="web.company_address_list"/>
                </div>
            </div>
        </div>

        <!-- BODY -->
        <t t-call="web.external_layout_body" custom_layout_address="True" hide_title="True">
            <div class="o_report_layout_tectora"
                 t-attf-style="{{report_type != 'pdf' and 'margin-top: 240px;' or ''}}">
                <h2 t-out="layout_document_title"/>
                <t t-out="0"/>
            </div>
        </t>

        <!-- FOOTER -->
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <t t-call="web.external_layout_footer_content"
               footer_content_classes="'o_tectora_footer'"/>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- Briefpapier: the Tectora letterhead (tectora-briefpapier-A4) -->
    <!-- ============================================================ -->

    <!-- The letterhead's brand: the Tectora logo with its slogan on the left,
         the services and the website on the right. White on the band of the
         primary colour; on the light band (letterhead_light) the logo in its
         own colours and the website in the primary colour. -->
    <template id="tectora_letterhead_brand">
        <img t-if="letterhead_light" class="o_tectora_lh_logo" src="/tectora_report_layout/static/src/img/tectora_logo.svg" alt="Tectora"/>
        <img t-else="" class="o_tectora_lh_logo" src="/tectora_report_layout/static/src/img/tectora_logo_white.svg" alt="Tectora"/>
        <div class="o_tectora_lh_services">
            <div t-if="not is_html_empty(company.report_header)" t-field="company.report_header"/>
            <div t-else="" t-out="services_fallback"/>
            <div t-if="company.website" class="o_tectora_lh_website"
                 t-att-style="letterhead_light and 'color: %s;' % tectora_color">— <t t-out="tectora_company._tectora_letterhead_website()"/></div>
        </div>
    </template>

    <!-- The letterhead's footer: a light band at the bottom of the page with
         the company data on three centred lines and a short line in the
         primary colour running off the right edge. With letterhead_light the
         colours swap: a band in the primary colour, text and line in white. -->
    <template id="tectora_letterhead_footer">
        <t t-set="footer_lines" t-value="tectora_company._tectora_letterhead_footer_lines()"/>
        <div t-attf-class="o_tectora_lh_footer {{report_type == 'pdf' and 'o_tectora_lh_footer_pdf' or ''}} {{letterhead_light and 'o_tectora_lh_footer_inverse' or ''}}"
             t-att-style="letterhead_light and 'background-color: %s;' % tectora_color">
            <div class="o_tectora_lh_footer_lines">
                <div t-if="footer_lines['identity']" t-out="footer_lines['identity']"/>
                <div t-if="not is_html_empty(company.report_footer)" t-field="company.report_footer" class="o_tectora_lh_footer_text"/>
                <div t-elif="footer_lines['contact']" t-out="footer_lines['contact']"/>
                <div t-if="footer_lines['banks']" t-out="footer_lines['banks']"/>
            </div>
            <div class="o_tectora_lh_accent" t-att-style="not letterhead_light and 'background-color: %s;' % tectora_color"/>
            <div t-if="report_type == 'pdf'" class="o_tectora_lh_pager">Pagina <span class="page"/> / <span class="topage"/></div>
            <div t-if="is_preview" class="o_tectora_lh_pager">Pagina 1 / 1</div>
        </div>
    </template>

    <!-- The letterhead as a layout: the band in the primary colour over the
         full width at the top, the light footer band at the bottom. The body
         is the one of the Tectora layout. -->
    <template id="external_layout_tectora_letterhead">
        <t t-set="tectora_color" t-value="company.primary_color or '#2D8D8F'"/>
        <!-- In the configurator's preview `company` is the configurator itself
             (base.document.layout), which has no address or bank accounts:
             those come from the company it configures. -->
        <t t-set="tectora_company" t-value="company.company_id if company._name == 'base.document.layout' else company"/>
        <t t-set="services_fallback" t-value="tectora_company._tectora_letterhead_services()"/>

        <!-- HEADER -->
        <div t-attf-class="header o_company_#{company.id}_layout">
            <div class="o_tectora_lh_header" t-attf-style="background-color: {{tectora_color}};">
                <t t-call="tectora_report_layout.tectora_letterhead_brand"/>
            </div>
        </div>

        <!-- BODY -->
        <t t-call="web.external_layout_body" hide_title="True">
            <div class="o_report_layout_tectora">
                <h2 t-out="layout_document_title"/>
                <t t-out="0"/>
            </div>
        </t>

        <!-- FOOTER -->
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <t t-call="tectora_report_layout.tectora_letterhead_footer"/>
        </div>
    </template>

    <!-- The letterhead's second colour scheme (page 2 of the artwork): a light
         band at the top with the logo in its own colours, the footer band in
         the primary colour. -->
    <template id="external_layout_tectora_letterhead_light">
        <t t-set="tectora_color" t-value="company.primary_color or '#2D8D8F'"/>
        <!-- In the configurator's preview `company` is the configurator itself
             (base.document.layout), which has no address or bank accounts:
             those come from the company it configures. -->
        <t t-set="tectora_company" t-value="company.company_id if company._name == 'base.document.layout' else company"/>
        <t t-set="services_fallback" t-value="tectora_company._tectora_letterhead_services()"/>
        <t t-set="letterhead_light" t-value="True"/>

        <!-- HEADER -->
        <div t-attf-class="header o_company_#{company.id}_layout">
            <div class="o_tectora_lh_header o_tectora_lh_light">
                <t t-call="tectora_report_layout.tectora_letterhead_brand"/>
            </div>
        </div>

        <!-- BODY -->
        <t t-call="web.external_layout_body" hide_title="True">
            <div class="o_report_layout_tectora">
                <h2 t-out="layout_document_title"/>
                <t t-out="0"/>
            </div>
        </t>

        <!-- FOOTER -->
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <t t-call="tectora_report_layout.tectora_letterhead_footer"/>
        </div>
    </template>

    <!-- The letterhead's band with the roof edge as its lower side: the band
         in the primary colour comes down lowest on the left and rises to the
         roof's peak at three quarters of the width; under it the roof edge
         as a light band and the ridge line, as in the Tectora layout. -->
    <template id="tectora_roof_letterhead_shape">
        <svg class="o_tectora_rlh_shape" preserveAspectRatio="none"
             viewBox="0 0 1000 160" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- band, its lower side the roof line -->
            <path d="M0 0H1000V120L777 104L0 136Z" t-att-fill="tectora_color"/>
            <!-- roof edge -->
            <path d="M0 142L777 110L1000 126V134L777 118L0 150Z" t-att-fill="tectora_color" fill-opacity=".16"/>
            <!-- ridge line -->
            <path d="M0 142L777 110L1000 126" t-att-stroke="tectora_color" stroke-width="1.5"
                  stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
        </svg>
    </template>

    <!-- The letterhead and the roof edge combined: the letterhead's band and
         brand with the roof edge as its lower side, the letterhead's footer. -->
    <template id="external_layout_tectora_roof_letterhead">
        <t t-set="tectora_color" t-value="company.primary_color or '#2D8D8F'"/>
        <!-- In the configurator's preview `company` is the configurator itself
             (base.document.layout), which has no address or bank accounts:
             those come from the company it configures. -->
        <t t-set="tectora_company" t-value="company.company_id if company._name == 'base.document.layout' else company"/>
        <t t-set="services_fallback" t-value="tectora_company._tectora_letterhead_services()"/>

        <!-- HEADER -->
        <div t-attf-class="header o_company_#{company.id}_layout">
            <div class="o_tectora_rlh_header">
                <t t-call="tectora_report_layout.tectora_roof_letterhead_shape"/>
                <t t-call="tectora_report_layout.tectora_letterhead_brand"/>
            </div>
        </div>

        <!-- PARTIES: the company with the salesperson's contact details on the
             left, the recipient and the site address on the right. -->
        <t t-set="tectora_document"
           t-value="o if o and o._name in ('sale.order', 'account.move', 'purchase.order') else None"/>
        <t t-set="tectora_parties">
            <t t-set="sender" t-value="tectora_company._tectora_letterhead_sender(tectora_document)"/>
            <t t-set="site" t-value="tectora_company._tectora_letterhead_site(tectora_document)"/>
            <div class="row mb-4 o_tectora_parties">
                <div class="col-6" name="tectora_sender">
                    <strong t-out="sender['name']"/>
                    <div t-foreach="sender['address']" t-as="line" t-out="line"/>
                    <div t-if="sender['contacts']" class="mt-3">
                        <div t-foreach="sender['contacts']" t-as="contact"><t t-out="contact[0]"/>: <t t-out="contact[1]"/></div>
                    </div>
                </div>
                <div class="col-5 offset-1" name="address">
                    <div class="o_tectora_recipient"><t t-out="address"/></div>
                    <t t-if="site">
                        <strong class="d-block mt-3">Werfadres</strong>
                        <div t-foreach="site" t-as="line" t-out="line"/>
                    </t>
                </div>
            </div>
        </t>

        <!-- BODY -->
        <t t-call="web.external_layout_body" hide_title="True"
           customized_address_layout="address and tectora_parties">
            <div class="o_report_layout_tectora">
                <h2 t-out="layout_document_title"/>
                <t t-out="0"/>
            </div>
        </t>

        <!-- FOOTER -->
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <t t-call="tectora_report_layout.tectora_letterhead_footer"/>
        </div>
    </template>

    <!-- The "Tectora" table design (Configure Document Layout -> Tables): a
         choice of its own next to Light, Boxed, Striped, ..., for every
         layout. Added after Odoo's chain of designs, which ends in ''. -->
    <template id="external_layout_body_tectora_table" inherit_id="web.external_layout_body">
        <xpath expr="//t[@t-set='external_layout_body_style_classes']" position="attributes">
            <attribute name="t-value"
                       add="(company.report_tables_id == 'tectora' and 'o_report_layout_tectora_table o_table_tectora' or '')"
                       separator=" or "/>
        </xpath>
    </template>

    <!-- The company colours in the layout's own part (the footer line) and
         in the Tectora table design: information band, table heads and the
         total. -->
    <template id="styles_company_report_tectora" inherit_id="web.styles_company_report">
        <xpath expr="//t[@t-elif=&quot;company.report_tables_id == 'column'&quot;]" position="after">
            <t t-elif="company.report_tables_id == 'tectora'">
                &amp;.o_table_tectora {
                    #informations {
                        border-color: mix(white, <t t-out='primary'/>, 60%);
                    }

                    table:not(.o_ignore_layout_styling) thead th {
                        border-bottom: 2px solid <t t-out='primary'/>;
                        color: <t t-out='primary'/>;
                    }

                    #total .o_total_table .o_total td {
                        background-color: mix(white, <t t-out='primary'/>, 90%);
                    }
                }
            </t>
        </xpath>
        <xpath expr="//t[@t-elif=&quot;layout == 'web.external_layout_lines'&quot;]" position="after">
            <t t-elif="layout in (
                'tectora_report_layout.external_layout_tectora',
                'tectora_report_layout.external_layout_tectora_letterhead',
                'tectora_report_layout.external_layout_tectora_letterhead_light',
                'tectora_report_layout.external_layout_tectora_roof_letterhead',
            )">
                &amp; .o_tectora_footer {
                    border-color: <t t-out='primary'/>;
                }
            </t>
        </xpath>
    </template>

</odoo>
