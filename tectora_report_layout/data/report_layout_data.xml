<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- The Tectora layout as a choice in Settings -> Configure Document
             Layout; the configurator renders its own live preview. -->
        <record id="report_layout_tectora" model="report.layout">
            <field name="name">Tectora</field>
            <field name="sequence">1</field>
            <field name="view_id" ref="tectora_report_layout.external_layout_tectora"/>
        </record>

        <!-- The Tectora letterhead (briefpapier), and the letterhead with the
             roof edge as the lower side of its band. -->
        <record id="report_layout_tectora_letterhead" model="report.layout">
            <field name="name">Tectora Briefpapier</field>
            <field name="sequence">2</field>
            <field name="view_id" ref="tectora_report_layout.external_layout_tectora_letterhead"/>
        </record>
        <record id="report_layout_tectora_letterhead_light" model="report.layout">
            <field name="name">Tectora Briefpapier licht</field>
            <field name="sequence">3</field>
            <field name="view_id" ref="tectora_report_layout.external_layout_tectora_letterhead_light"/>
        </record>
        <record id="report_layout_tectora_roof_letterhead" model="report.layout">
            <field name="name">Tectora Briefpapier met dakrand</field>
            <field name="sequence">4</field>
            <field name="view_id" ref="tectora_report_layout.external_layout_tectora_roof_letterhead"/>
        </record>
    </data>
</odoo>
